{
  // ============================================================
  // 纯静态导航站：无 KV、无 cron、无回源
  // 页面里的订阅链接直连上游原站，数据新鲜度由原站负责
  // ============================================================
  "name": "cf-nav",
  "main": "_worker.js",
  "compatibility_date": "2026-11-20",

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
    // 不需要 run_worker_first：所有静态请求由平台直出，只有未命中的路径才进 Worker
  },

  "observability": {
    "enabled": true
  },

  // workers.dev 作为备用入口保留（部分地区被墙，主入口用自定义域名）
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cf-nav.315267532.xyz",
      "custom_domain": true
    }
  ]
}
